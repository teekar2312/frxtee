// ZeniTrade AI — Prisma schema
// The Python backend uses its own SQLite DB (db.py) for trades/alerts/logs/risk.
// This Prisma schema is reserved for future dashboard-side features (user
// accounts, saved layouts) if needed. The DATABASE_URL env must point to a
// writable SQLite file for Prisma Client to initialize without error.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Reserved for future dashboard-side features (auth, saved layouts).
// Currently no models are needed — all trading data lives in the Python
// backend's SQLite DB (zenitrade.db) managed by db.py.
