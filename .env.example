# ZeniTrade AI — Next.js Dashboard environment
# Copy to .env.local and adjust as needed.

# Python backend URL (auto-detected; dashboard proxies all /api/trading/* here)
# Default: http://127.0.0.1:8000 (set TRADING_BACKEND_URL to override)
TRADING_BACKEND_URL=http://127.0.0.1:8000

# API token — must match ZENITRADE_API_TOKEN in python-backend/.env
# Required when the backend has auth enabled. Leave empty for dev (no auth).
ZENITRADE_API_TOKEN=

# Prisma database (dashboard-side; reserved for future user accounts)
DATABASE_URL="file:./db/custom.db"
# Note: on Windows use forward slashes or double backslashes: file:./db/custom.db

# Log format: "json" for production (ELK/Loki), "text" for dev readability
LOG_FORMAT=text

# Sentry DSN (optional error monitoring; empty = disabled)
SENTRY_DSN=
