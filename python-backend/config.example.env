# ===== MetaTrader 5 / FINEX =====
MT5_LOGIN=50120000
MT5_PASSWORD=your_password
MT5_SERVER=FINEX-Real
MT5_TERMINAL_PATH=C:\Program Files\FINEX MetaTrader 5\terminal64.exe
MT5_AUTO_LAUNCH=true

# ===== News APIs =====
FINNHUB_API_KEY=your_finnhub_key
MARKETAUX_API_KEY=your_marketaux_key

# ===== AI Providers (manual selection in UI) =====
ZAI_API_KEY=your_zai_key
GROQ_API_KEY=your_groq_key
GOOGLE_API_KEY=your_google_ai_studio_key
OPENROUTER_API_KEY=your_openrouter_key
OLLAMA_URL=http://127.0.0.1:11434

# AI provider models (configurable)
ZAI_MODEL=glm-4.6
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MODEL=gemini-1.5-pro
OPENROUTER_MODEL=deepseek/deepseek-chat
OLLAMA_MODEL=llama3

# AI confidence thresholds
AI_MIN_CONFIDENCE=60
AUTO_TRADE_MIN_CONFIDENCE=75

# ===== Money Management defaults =====
RISK_PER_TRADE_PCT=1.0
STOP_LOSS_PIPS=10
RR_RATIO=1.5
MAX_OPEN_POSITIONS=3
DAILY_RISK_LIMIT_PCT=3.0
DAILY_TARGET_PCT=2.0
AVOID_HIGH_IMPACT_NEWS=true

# Trading sessions — comma-separated: sydney, tokyo, london, newyork
# Empty = trade all sessions. Default: london + newyork (best liquidity)
ACTIVE_SESSIONS=london,newyork

# ===== Email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=trader@example.com
SMTP_PASSWORD=app_password
EMAIL_TO=trader@example.com

# ===== Server =====
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== Security (REQUIRED for production) =====
# Set a strong random token; the dashboard must send it as X-API-Token header.
# When empty, the API is unauthenticated (dev only — NEVER deploy empty).
# IMPORTANT: If you set this here, you MUST also set the SAME token in
# the dashboard .env.local as ZENITRADE_API_TOKEN or all POST requests
# will return 401 and fall back to demo mode.
# For local dev: leave EMPTY (no auth needed on localhost).
ZENITRADE_API_TOKEN=

# ===== Persistence =====
DB_PATH=zenitrade.db

# ===== Error monitoring (optional) =====
# Set to your Sentry DSN to capture exceptions in production. Empty = disabled.
SENTRY_DSN=

# ===== Notification channels =====
# Telegram (optional — get token from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optional — webhook URL from channel settings)
DISCORD_WEBHOOK_URL=

# Which channels: "email", "email,telegram", "email,telegram,discord"
NOTIFY_CHANNELS=email

# ===== Multi-account (optional) =====
MT5_ACCOUNTS=
